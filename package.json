{
  "name": "optimizer-desktop",
  "version": "2.2.3",
  "description": "Windows 10/11 Performance, Input Delay & Network Optimizer",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/main/catalog', {recursive:true}); fs.copyFileSync('src/main/catalog/catalog.json', 'dist-electron/main/catalog/catalog.json');\"",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:all": "npm run build && electron-builder --win nsis portable",
    "release": "node scripts/release.js --patch",
    "release:patch": "node scripts/release.js --patch",
    "release:minor": "node scripts/release.js --minor",
    "release:major": "node scripts/release.js --major",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.optimizer.desktop",
    "productName": "Optimizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/catalog/catalog.json",
        "to": "catalog.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Optimizer",
      "artifactName": "Optimizer-Setup-${version}.${ext}",
      "uninstallDisplayName": "Optimizer"
    },
    "portable": {
      "artifactName": "Optimizer-Portable-${version}.${ext}",
      "requestExecutionLevel": "admin"
    }
  },
  "keywords": [
    "windows",
    "optimizer",
    "latency",
    "gaming",
    "performance"
  ],
  "author": "Optimizer Team",
  "license": "MIT",
  "dependencies": {
    "@splinetool/runtime": "^2.0.66",
    "@types/three": "^0.186.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
